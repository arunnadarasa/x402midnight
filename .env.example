# Sepolia deploy + UI (copy to .env — never commit .env)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
PK=0xYOUR_SEPOLIA_DEPLOYER_PRIVATE_KEY
VITE_SEPOLIA_PAY_TO=0xYOUR_MERCHANT_ADDRESS
VITE_SEPOLIA_PAYWALL=
VITE_SEPOLIA_RPC=
# Optional: USD per cirBTC for amount conversion (demo default 100000)
VITE_CIRBTC_USD=100000

# Etherscan API key (https://etherscan.io/myapikey) — verify ChunkPaywall
ETHERSCAN_API_KEY=

